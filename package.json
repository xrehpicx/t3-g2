{
  "name": "t3-g2",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "scripts": {
    "dev": "vite --mode personal",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pack": "npm run build && node scripts/pack.mjs",
    "simulate": "evenhub-simulator http://localhost:5173",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "pack:personal": "tsc --noEmit && vite build --mode personal && node scripts/pack.mjs --personal"
  },
  "dependencies": {
    "@evenrealities/even_hub_sdk": "^0.0.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "even-toolkit": "^1.7.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.7"
  },
  "description": "Your pinned T3 Code threads on Even G2 glasses, live, with voice replies.",
